# Copia aquest fitxer a `.env` i omple els valors.
# `.env` NO es puja al repositori (ha d'estar al .gitignore).

# --- General ---------------------------------------------------------------
NODE_ENV=production

# --- Frontend (nginx) ------------------------------------------------------
# Port del host on es publica l'aplicació
FRONTEND_PORT=8080

# --- Backend (Node.js + Socket.IO) -----------------------------------------
# Port intern del backend (ha de coincidir amb el proxy_pass de nginx.conf)
BACKEND_PORT=3000
# Origen permès per CORS / Socket.IO (URL pública del frontend)
CORS_ORIGIN=http://localhost:8080

# --- TURN / STUN (coturn) --------------------------------------------------
# IP o domini públic del servidor TURN (el que veuen els navegadors)
TURN_HOST=localhost
TURN_PORT=3478
TURN_REALM=bomb-station
TURN_USER=bomb
# Canvia aquesta contrasenya en qualsevol entorn que no sigui local
TURN_PASSWORD=change-me

# --- Base de dades (opcional, només si hi ha persistència) -----------------
# DB_PATH=./data/bomb-station.sqlite

# --- MySQL (opcional, alternativa a SQLite via docker-compose) -------------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bomb_station
MYSQL_USER=bomb_station
MYSQL_PASSWORD=change-me